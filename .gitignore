.DS_Store
# Runtime state stays out; tracked gate config (project.conf + validate.sh)
# must reach the reviewer snapshot worktree.
/.agent-arena/*
!/.agent-arena/project.conf
!/.agent-arena/validate.sh
dist/
*.tar.gz
*.sha256

# Runtime state is deliberately external; keep accidental local copies out of Git.
state/
worktrees/
.worktrees/
.zell/
ui/target/
